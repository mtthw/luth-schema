{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luth:schema:exercise:0.0.1",
  "title": "Lúth exercise definition 0.0.1",
  "description": "Exercise definition only; excludes app-specific metadata. Use the SDK validators to enforce nesting and expanded-step limits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "countdownTones", "sets"],
  "properties": {
    "schemaVersion": { "const": "0.0.1", "type": "string" },
    "title": { "$ref": "#/$defs/title" },
    "description": { "$ref": "#/$defs/description" },
    "countdownTones": { "$ref": "#/$defs/tones" },
    "color": { "$ref": "#/$defs/color" },
    "sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/subset" }
    }
  },
  "$defs": {
    "title": { "type": "string", "pattern": "[^\\s\\u0085\\uFEFF]" },
    "description": {
      "description": "CommonMark text; apps display only the subset described in the README.",
      "type": ["string", "null"],
      "maxLength": 10000
    },
    "argb": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "modeColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/argb" },
        "dark": { "$ref": "#/$defs/argb" }
      }
    },
    "color": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/argb" },
        { "$ref": "#/$defs/modeColor" }
      ]
    },
    "tone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitch", "length"],
      "properties": {
        "pitch": {
          "type": "string",
          "enum": ["E2", "F2", "Fs2", "G2", "Gs2", "A2", "As2", "B2", "C3", "Cs3", "D3", "Ds3", "E3", "F3", "Fs3", "G3", "Gs3", "A3", "As3", "B3", "C4", "Cs4", "D4", "Ds4", "E4", "F4", "Fs4", "G4", "Gs4", "A4", "As4", "B4", "C5", "Cs5", "D5", "Ds5", "E5", "F5", "Fs5", "G5", "Gs5", "A5", "As5", "B5", "C6"]
        },
        "length": { "enum": ["automatic", "short", "long"] }
      }
    },
    "tones": { "type": "array", "items": { "$ref": "#/$defs/tone" } },
    "subset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "reps", "subsets", "skipLast"],
      "properties": {
        "title": { "$ref": "#/$defs/title" },
        "description": { "$ref": "#/$defs/description" },
        "reps": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "durationMicroseconds": {
          "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991
        },
        "color": { "$ref": "#/$defs/color" },
        "subsets": {
          "type": "array", "maxItems": 10000,
          "items": { "$ref": "#/$defs/subset" }
        },
        "countdownTones": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/tones" }] },
        "skipLast": { "type": "boolean" }
      },
      "allOf": [{
        "if": {
          "required": ["durationMicroseconds"],
          "properties": { "durationMicroseconds": { "type": "integer" } }
        },
        "then": { "properties": { "subsets": { "type": "array", "maxItems": 0 } } }
      }]
    }
  }
}
